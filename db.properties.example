# DB 접속 설정 예시
# 이 파일을 복사해서 이름을 db.properties 로 바꾸고, 내 MySQL 비밀번호를 적어 주세요.
# db.properties 는 비밀번호가 들어 있어서 Git에 올리지 않습니다. (.gitignore 에 등록됨)
db.url=jdbc:mysql://localhost:3306/cafe?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&useSSL=false&allowPublicKeyRetrieval=true
db.user=root
db.password=여기에_내_MySQL_비밀번호
